# ==============================================================================
# Telesales Intelligence System - Environment Configuration
# ==============================================================================

# Database Connection (PostgreSQL 14+)
DATABASE_URL=postgresql+psycopg://telesales:telesales_secret@127.0.0.1:5434/telesales_db

# Cohere API Configuration
COHERE_API_KEY=your_cohere_api_key_here
COHERE_MODEL=command-r-plus-08-2024
COHERE_EMBED_MODEL=embed-multilingual-v3.0
COHERE_TEMPERATURE=0.0
COHERE_TIMEOUT_SECONDS=60
COHERE_MAX_RETRIES=3

# When set to true or when COHERE_API_KEY is empty/placeholder, the system uses
# deterministic Jordanian Arabic heuristic extraction for hermetic local testing.
COHERE_MOCK_MODE=false

# Analysis & Coaching Configuration
# Language options: "ar" (Jordanian Arabic) or "en" (English)
COACHING_LANGUAGE=ar

# Ingestion & Concurrency
BATCH_CONCURRENCY=4
TRANSCRIPTS_FOLDER_PATH=./data/sample_transcripts

# Microsoft Power BI Service API Integration (Optional)
POWERBI_REFRESH_ENABLED=false
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_DATASET_ID=

# Server & Operations
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
